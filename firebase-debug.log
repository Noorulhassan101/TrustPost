[debug] [2026-08-15T23:40:00.171Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-entryai-test:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // Check if the current authenticated user has a member document in this company\r\n    function isCompanyMember(companyId) {\r\n      return request.auth != null && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));\r\n    }\r\n    \r\n    match /users/{uid} {\r\n      // Users can only access their own profile\r\n      allow read, write: if request.auth != null && request.auth.uid == uid;\r\n    }\r\n    \r\n    match /companies/{companyId} {\r\n      allow create: if request.auth != null;\r\n      // Only members can read the core company data\r\n      allow read: if isCompanyMember(companyId);\r\n      // All other modifications require server logic or admin paths\r\n      allow update, delete: if false; \r\n      \r\n      match /members/{memberId} {\r\n        // Members can see who else is in the company\r\n        allow read: if isCompanyMember(companyId);\r\n        // Allow founders to join the company during setup\r\n        allow create: if request.auth != null && request.auth.uid == memberId;\r\n        allow update, delete: if false;\r\n      }\r\n      \r\n      match /connections/{connectionId} {\r\n        allow read, write: if isCompanyMember(companyId);\r\n      }\r\n      \r\n      match /documents/{docId} {\r\n        // Members have full CRUD access to their company's documents directly\r\n        allow read, write: if isCompanyMember(companyId);\r\n      }\r\n      \r\n      match /logs/{logId} {\r\n        allow read: if isCompanyMember(companyId);\r\n        allow write: if false; // logs are immutable and written natively by cloud functions\r\n      }\r\n    }\r\n  }\r\n}\r\n"}]}}
