rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the current authenticated user has a member document in this company
    function isCompanyMember(companyId) {
      return request.auth != null && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }
    
    match /users/{uid} {
      // Users can only access their own profile
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /companies/{companyId} {
      // Only members can read the core company data
      allow read: if isCompanyMember(companyId);
      // All creation and management of core company attributes occurs via Cloud Functions
      allow write: if false; 
      
      match /members/{memberId} {
        // Members can see who else is in the company
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }
      
      match /connections/{connectionId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false; // connections managed via functions
      }
      
      match /documents/{docId} {
        // Members have full CRUD access to their company's documents directly
        allow read, write: if isCompanyMember(companyId);
      }
      
      match /logs/{logId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false; // logs are immutable and written natively by cloud functions
      }
    }
  }
}
