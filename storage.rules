rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Core protection for company documents
    match /companies/{companyId}/documents/{fileName} {
      // Any authenticated user can download documents (company isolation strictly managed by app logic here for MVP since Storage lacks native Firestore joins)
      allow read: if request.auth != null; 
      
      // Enforce 10MB file limit and restrict to PDF/Images
      allow write: if request.auth != null 
                   && request.resource.size < 10 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
